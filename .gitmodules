[submodule "submodules/Sparkle"]
	path = submodules/Sparkle
	url = https://github.com/sparkle-project/Sparkle
[submodule "submodules/telegram-ios"]
	path = submodules/telegram-ios
	url = https://github.com/klaipher/nanogram.git
	branch = main
[submodule "submodules/tgcalls"]
	path = submodules/tgcalls
	url = https://github.com/klaipher/tgcalls.git
	branch = nanogram-shared
	shallow = true
[submodule "submodules/webrtc"]
	path = submodules/webrtc
	url = https://github.com/klaipher/webrtc.git
	branch = nanogram
	shallow = true
[submodule "submodules/tlottie"]
	path = submodules/tlottie
	url = https://github.com/dkaraush/tlottie
[submodule "third-party/twidget"]
	path = third-party/twidget
	url = https://github.com/klaipher/twidget.git
	branch = nanogram
[submodule "third-party/widget-sandbox"]
	path = third-party/widget-sandbox
	url = https://github.com/klaipher/widget-sandbox.git
	branch = nanogram
