{
 "schema": 1,
 "platform": {
  "swift_opt": {
   "label": "Swift optimisation, Release",
   "ios": "-O (swift.opt_uses_osize off)",
   "mac": "-O; -Osize for 12 cold feature modules",
   "equal": "yes, except the 12 listed Mac modules",
   "probes": {
    "ios": [
     {
      "id": "Make.py",
      "file": "build-system/Make/Make.py",
      "regex": "(Swift modules build with -O \\(speed\\) rather than -Osize)"
     }
    ],
    "mac": [
     {
      "id": "xcconfig",
      "file": "nanogram/Nanogram.xcconfig",
      "regex": "(SWIFT_OPTIMIZATION_LEVEL\\[config=Release\\] = \\$\\(NANOGRAM_SWIFT_OPT_\\$\\(TARGET_NAME\\):default=-O\\))"
     }
    ]
   }
  },
  "swift_debug": {
   "label": "Swift optimisation, Debug",
   "ios": "-Onone (fastbuild/dbg)",
   "mac": "-Onone",
   "equal": "yes",
   "probes": {
    "ios": [],
    "mac": [
     {
      "id": "xcconfig",
      "file": "nanogram/Nanogram.xcconfig",
      "regex": "(SWIFT_OPTIMIZATION_LEVEL\\[config=Debug\\] = -Onone)"
     }
    ]
   }
  },
  "wmo": {
   "label": "Whole-module optimisation, Release",
   "ios": "on (swift.opt_uses_wmo)",
   "mac": "on (SWIFT_COMPILATION_MODE=wholemodule)",
   "equal": "yes",
   "probes": {
    "ios": [
     {
      "id": "Make.py",
      "file": "build-system/Make/Make.py",
      "regex": "(--features=swift.opt_uses_wmo)"
     }
    ],
    "mac": [
     {
      "id": "xcconfig",
      "file": "nanogram/Nanogram.xcconfig",
      "regex": "(SWIFT_COMPILATION_MODE\\[config=Release\\] = wholemodule)"
     }
    ]
   }
  },
  "c_lto": {
   "label": "C, C++, Objective-C LTO, Release",
   "ios": "ThinLTO (-flto=thin)",
   "mac": "ThinLTO (LLVM_LTO=YES_THIN), also -O3",
   "equal": "yes",
   "probes": {
    "ios": [
     {
      "id": "Make.py",
      "file": "build-system/Make/Make.py",
      "regex": "(--copt=-flto=thin)"
     }
    ],
    "mac": [
     {
      "id": "xcconfig",
      "file": "nanogram/Nanogram.xcconfig",
      "regex": "(LLVM_LTO\\[config=Release\\] = YES_THIN)"
     }
    ]
   }
  },
  "rust_lto": {
   "label": "Rust LTO, Release",
   "ios": "fat",
   "mac": "fat (one nanogram-rust staticlib, crate profile)",
   "equal": "yes",
   "probes": {
    "ios": [
     {
      "id": "Make.py",
      "file": "build-system/Make/Make.py",
      "regex": "(rust/settings:lto=fat)"
     }
    ],
    "mac": [
     {
      "id": "nanogram-rust Cargo.toml",
      "file": "submodules/telegram-ios/third-party/nanogram-rust/Cargo.toml",
      "regex": "(?s)crate-type = \\[\"staticlib\"\\].*lto = \"(fat)\""
     }
    ]
   }
  },
  "dead_strip": {
   "label": "Dead-code stripping, Release",
   "ios": "on (--features=dead_strip)",
   "mac": "on (DEAD_CODE_STRIPPING=YES)",
   "equal": "yes",
   "probes": {
    "ios": [
     {
      "id": "Make.py",
      "file": "build-system/Make/Make.py",
      "regex": "(--features=dead_strip)"
     }
    ],
    "mac": [
     {
      "id": "xcconfig",
      "file": "nanogram/Nanogram.xcconfig",
      "regex": "(DEAD_CODE_STRIPPING\\[config=Release\\] = YES)"
     }
    ]
   }
  }
 },
