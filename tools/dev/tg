#!/usr/bin/env bash
# tg — local development helper for Nanogram for macOS.
# Argument parsing only; the logic lives in tools/dev/nanogram/*.py.
# See docs/local-development.md.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export TG_CALLER_CWD="$PWD"
cd "$ROOT"

export PATH="/opt/homebrew/opt/rustup/bin:$PATH"
if [ -z "${DEVELOPER_DIR:-}" ]; then
  DEVELOPER_DIR="$(xcode-select -p 2>/dev/null || true)"
  export DEVELOPER_DIR
fi
export PYTHONPATH="$ROOT/tools/dev${PYTHONPATH:+:$PYTHONPATH}"

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

py() { python3 -m "nanogram.$1" "${@:2}"; }

# The cache cleanup, worktree, native-library, performance and pre-push tools are one copy for iOS, Mac and Android:
# klaipher/nanogram-deps, reached through the core (submodules/telegram-ios/shared/tools). Each takes this repository
# with --repo or --root.
SHARED_TOOLS="$ROOT/submodules/telegram-ios/shared/tools"
export NANOGRAM_REPO_ROOT="$ROOT"
shared_tool() {
  local tool="$SHARED_TOOLS/$1"
  [ -f "$tool" ] || die "$tool is missing; run: git submodule update --init submodules/telegram-ios && git -C submodules/telegram-ios submodule update --init shared"
  shift
  python3 "$tool" "$@"
}

not_yet() { die "tg $1 is not implemented yet"; }

config_value() { python3 -c "from nanogram import config; print(config.$1)"; }

cmd_doctor() { py doctor; }

# tg cache-cleanup [--dry-run] [--only A,B]: the shared cache cleanup (shared/tools/cachegc in the core, policy in submodules/telegram-ios/shared/cache-policy.json).
# It also runs by itself, throttled and time-boxed, after build, test, check and release commands. There is no
# scheduled job.
cmd_cache_cleanup() {
  case "${1:-}" in
    verify|report|guard) shared_tool cachegc/cachegc.py "$1" --repo "$ROOT" ;;
    *) shared_tool cachegc/cachegc.py run --repo "$ROOT" "$@" ;;
  esac
}

cache_cleanup_auto() {
  [ -z "${NANOGRAM_TG_LOCKED:-}" ] || return 0
  shared_tool cachegc/cachegc.py auto --repo "$ROOT" || true
}

# tg apps [--dry-run]: one Nanogram in Spotlight and Launchpad. Every build, archive, export and mounted disk image
# registers its Nanogram.app with LaunchServices; this unregisters all but /Applications/Nanogram.app (files stay).
# It also runs by itself after every command that builds.
cmd_apps() { py appregistry "$@"; }

apps_tidy_auto() {
  [ -z "${NANOGRAM_TG_LOCKED:-}" ] || return 0
  py appregistry --quiet || true
}

after_build_command() {
  cache_cleanup_auto
  apps_tidy_auto
}

# Runs before every build command (not throttled): enforces the hard caps and removes what deleted checkouts left behind,
# and refuses to start a build below the hard free-space floor (shared/cache-policy.json in the core; TG_ALLOW_LOW_DISK=1 overrides).
# A command that calls another tg command (check -> build) is guarded once; so is everything under buildlock.
cache_guard() {
  [ -z "${NANOGRAM_TG_LOCKED:-}" ] || return 0
  [ -z "${TG_CACHE_GUARDED:-}" ] || return 0
  export TG_CACHE_GUARDED=1
  # Without the core checked out there is nothing to build yet; the build command fails on its own with a clear message.
  [ -f "$SHARED_TOOLS/cachegc/cachegc.py" ] || { warn "cache guard skipped: the shared tools are not checked out"; return 0; }
  local status=0
  python3 "$SHARED_TOOLS/cachegc/cachegc.py" guard --repo "$ROOT" || status=$?
  # Exit 1 is the refusal (too little free disk); any other failure of the guard itself must not stop a build.
  [ "$status" -ne 1 ] || exit 1
}

# tg worktree add <name> [--branch B] [--from REF] | remove <name> [--force]: shared/tools/worktree/worktree.py (the
# same module for every app repository). Nothing is built.
cmd_worktree() { shared_tool worktree/worktree.py --repo "$ROOT" --flavor mac "$@"; }

cmd_native() {
  shared_tool native/check_native_libs.py --root "$ROOT" "$@" && shared_tool native/module_settings.py --check --root "$ROOT" && py manifestpaths
}

cmd_frameworks() { py frameworks "$@"; }

# tg clean [--all]: this checkout's DerivedData/Build (all of its DerivedData with --all) and build-output/apps.
cmd_clean() { py disk clean "$@"; }

# tg prune [--dry-run] [--max-gb N]: lists everything under ~/.cache/nanogram-macos, removes stale build caches.
cmd_prune() {
  py disk prune "$@"
  local dry=()
  case " $* " in *" --dry-run "*) dry=(--dry-run) ;; esac
  cmd_cache_cleanup ${dry[@]+"${dry[@]}"}
}

# Writes the gitignored NanogramSecrets.swift (api_id/api_hash); prints only the path, never the values.
cmd_credentials() { py credentials || die "cannot generate API credentials"; }

# Sparkle EdDSA key for the direct edition: creates ~/.config/nanogram-macos/sparkle_ed25519 (0600) once and
# prints the public key (SUPublicEDKey); `tg sparkle-key sign <archive>` prints the appcast signature.
cmd_sparkle_key() {
  if [ "${1:-}" = sign ]; then py sparkle sign "${@:2}"; else py sparkle public-key; fi
}

# The core's nested copies of libraries this repository pins itself, at the same commits (webrtc, tgcalls, twidget,
# widget-sandbox and its QuickJS): the Mac builds its own checkouts, so the core's stay unchecked-out (one working tree
# and object store each, about 250 MB). Never tlottie: the build compiles the core's copy. Done with the core's
# `submodule.active` pathspec (a per-submodule `submodule.<path>.active=false` is switched back on by `update --init`).
CORE_DUPLICATE_SUBMODULES=(
  third-party/webrtc/webrtc
  submodules/TgVoipWebrtc/tgcalls
  third-party/twidget/twidget
  third-party/widget-sandbox/widget-sandbox
  third-party/quickjs-ng/quickjs
)

core_skip_duplicate_submodules() {
  local core=submodules/telegram-ios path
  [ -e "$core/.git" ] || return 0
  git -C "$core" config --unset-all submodule.active || true
  git -C "$core" config --add submodule.active .
  for path in "${CORE_DUPLICATE_SUBMODULES[@]}"; do
    git -C "$core" config --add submodule.active ":(exclude)$path"
    if [ -e "$core/$path/.git" ]; then
      git -C "$core" submodule deinit -- "$path" >/dev/null 2>&1 || warn "could not deinit the core's duplicate checkout $core/$path (local changes?): remove it by hand"
    fi
  done
}

# tg submodules: every submodule at its recorded commit, without the core's duplicates of what this repository pins.
cmd_submodules() {
  git submodule sync --recursive >/dev/null
  git submodule update --init --jobs 8 submodules/telegram-ios
  core_skip_duplicate_submodules
  git submodule update --init --recursive --jobs 8
}

cmd_setup() {
  # Recorded conflict resolutions are replayed on the next upstream merge (tg sync-upstream).
  git config rerere.enabled true
  git config rerere.autoupdate true
  say "Fetching submodules"
  cmd_submodules
  local toolchain
  toolchain="$(sed -n 's/^channel *= *"\(.*\)"/\1/p' core-xprojects/rust-toolchain.toml)"
  [ -n "$toolchain" ] || die "cannot read the Rust toolchain pinned in core-xprojects/rust-toolchain.toml"
  command -v rustup >/dev/null || die "rustup missing: brew install rustup"
  say "Installing Rust $toolchain (core-xprojects/rust-toolchain.toml)"
  rustup toolchain install "$toolchain" --profile minimal
  rustup target add --toolchain "$toolchain" aarch64-apple-darwin
  cmd_frameworks
}

edition_xcconfig() {
  local file="$ROOT/nanogram/editions/$1.xcconfig"
  [ -f "$file" ] || die "unknown edition '$1' (no $file)"
  echo "$file"
}

# tg build [--release] [--clean] [--resolve-packages] [--edition mas|direct] [-- extra xcodebuild args]
# --clean deletes DerivedData/Build first, so every file compiles and every warning is in the log.
# xcodebuild runs through tools/dev/nanogram/xcbuild.py with fixed arguments and environment, so Xcode keeps
# its cached build description; packages resolve only with --clean or --resolve-packages.
# It holds this checkout's build lock shared (tg frameworks and tg clean hold it exclusively); under buildlock it
# does not wait for it.
cmd_build() {
  if [ -z "${NANOGRAM_TG_LOCKED:-}" ]; then
    NANOGRAM_TG_LOCKED=1 py checkoutlock --shared -- "$ROOT/tools/dev/tg" build "$@"
    return
  fi
  local release=0 clean=0 resolve=0 edition=direct extra=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --release) release=1 ;;
      --clean) clean=1 ;;
      --resolve-packages) resolve=1 ;;
      --edition) [ $# -ge 2 ] || die "--edition needs mas or direct"; edition="$2"; shift ;;
      --) shift; extra=("$@"); break ;;
      *) die "unknown build option: $1" ;;
    esac
    shift
  done
  local xcconfig scheme configuration conditions derived log
  xcconfig="$(edition_xcconfig "$edition")"
  if [ "$release" = 1 ]; then scheme=Release configuration=Release; else scheme=Telegram configuration=Debug; fi
  conditions='$(inherited) NANOGRAM STABLE'
  [ "$edition" = mas ] && conditions="$conditions NANOGRAM_MAS"
  local settings=() setting
  if [ "$release" = 1 ]; then
    while IFS= read -r setting; do settings+=("$setting"); done < <(py release settings)
  fi
  derived="$(config_value DERIVED_DATA)"
  mkdir -p "$ROOT/build-output"
  log="$ROOT/build-output/last-build.log"
  cmd_credentials
  if [ "$clean" = 1 ]; then
    say "Cleaning ${derived}/Build"
    rm -rf "${derived:?}/Build"
  fi
  py editions --edition "$edition" --before-build "$derived"

  say "Building $configuration ($edition edition), log: build-output/last-build.log"
  local start=$SECONDS status=0
  local run_args=(--configuration "$configuration" --scheme "$scheme" --derived "$derived" --xcconfig "$xcconfig"
    --conditions "$conditions" --log "$log")
  [ "$clean" = 1 ] && run_args+=(--clean)
  [ "$resolve" = 1 ] && run_args+=(--resolve-packages)
  for setting in ${settings[@]+"${settings[@]}"}; do run_args+=(--setting "$setting"); done
  py xcbuild run "${run_args[@]}" -- ${extra[@]+"${extra[@]}"} || status=$?
  local elapsed=$((SECONDS - start))
  if [ "$status" != 0 ]; then
    grep -E '(error|fatal error):' "$log" | sort -u | head -30 >&2 || true
    die "build failed after ${elapsed}s (exit $status); full log: $log"
  fi
  say "Built in ${elapsed}s; checking architectures and deployment target"
  local check_args=(--log "$log" --products "$derived/Build/Products/$configuration")
  [ "$release" = 1 ] && check_args+=(--release)
  py buildcheck "${check_args[@]}" || die "buildcheck failed: the settings layer did not reach every target"
  py editions --edition "$edition" --configuration "$configuration" --products "$derived/Build/Products/$configuration" \
    || die "the $edition edition is wrong (signing, sandbox or Sparkle); see above"
}

# tg warnings [--update] [--log FILE]: counts upstream warnings of a clean debug build (built here unless
# --log names one) and fails when a package has more than nanogram/warnings-baseline.json allows.
cmd_warnings() {
  local log="" args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --update) args+=(--update) ;;
      --log) [ $# -ge 2 ] || die "--log needs a file"; log="$2"; shift ;;
      *) die "unknown warnings option: $1" ;;
    esac
    shift
  done
  if [ -z "$log" ]; then
    cmd_build --clean
    log="$ROOT/build-output/warnings-build.log"
    cp "$ROOT/build-output/last-build.log" "$log"
  fi
  py warnings --log "$log" ${args[@]+"${args[@]}"}
}

# tg upstream-sync --tag <upstream tag> [--offline] [--json]: dry run of an upstream release merge (conflicts by area,
# bumped pins against our fork branches) in a scratch repository; changes and fetches nothing in this repo. The real
# merge is tg sync-upstream below. The script is the shared one (shared/tools/upstream-sync); the settings stay in
# tools/dev/upstream-sync/upstream-sync.json.
cmd_upstream_sync() { shared_tool upstream-sync/sync.py --repo "$ROOT" "$@"; }

# tg sync-upstream [--no-build] [--after-merge]: fast-forward `upstream` to telegram/master (real history),
# merge it into the current branch (tools/dev/nanogram/sync.py; stops on conflicts, never resolves them), then
# submodules, native libraries, a clean build whose new upstream warnings join the baseline, tg check.
# --after-merge runs only the post-merge steps (after you resolved and committed a conflicted merge).
cmd_sync_upstream() {
  local build=1 merge=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-build) build=0 ;;
      --after-merge) merge=0 ;;
      *) die "unknown sync-upstream option: $1" ;;
    esac
    shift
  done
  if [ "$merge" = 1 ]; then
    local status=0
    py sync || status=$?
    case "$status" in
      0) ;;
      3) return 0 ;;
      1) exit 1 ;;
      *) die "sync-upstream failed (exit $status)" ;;
    esac
  fi
  [ "$build" = 1 ] || { say "Merged; skipped the post-merge build (--no-build)"; return 0; }
  say "Updating submodules to the merged pins"
  cmd_submodules
  cmd_frameworks
  cmd_warnings --update
  "$ROOT/tools/dev/tg" check
  say "Synced. Commit nanogram/warnings-baseline.json if it changed."
}

# tg testflight [--export-only]: Release archive of the mas edition (build number TG_BUILD_NUMBER or the time),
# buildcheck, App Store export with automatic signing (App Store Connect API key), altool upload.
cmd_testflight() { py release testflight "$@"; }

# tg release-direct: Release archive of the direct edition, Developer ID export, notarized and stapled dmg,
# Sparkle appcast and source archive in build-output/direct/<build>/. Uploads nothing.
cmd_release_direct() { py release release-direct "$@"; }

cmd_xcode() {
  local edition="${1:-direct}" xcconfig
  xcconfig="$(edition_xcconfig "$edition")"
  cmd_credentials
  if pgrep -x Xcode >/dev/null; then
    warn "Xcode is already running and will not see XCODE_XCCONFIG_FILE; quit it first, then run tg xcode again"
  fi
  say "Opening the workspace with XCODE_XCCONFIG_FILE=${xcconfig#"$ROOT"/}"
  open --env "XCODE_XCCONFIG_FILE=$xcconfig" -a Xcode "$ROOT/Telegram-Mac.xcworkspace"
}

# tg parity [--release] [--ios-repo DIR] [--ios-ref REF]: the iOS/macOS parity gate (tools/dev/parity/parity.py,
# rules in docs/mac-core-paths.txt): history roots, published pins, equal tgcalls/tlottie SHAs, core pin on
# iOS main and its lag, shared files without an allow entry, WebRTC differences. Exit 1 on any error.
cmd_parity() { python3 "$ROOT/tools/dev/parity/parity.py" check --root "$ROOT" "$@"; }

# tg core-bump [REF|SHA] [--dry-run] [--no-fetch] [--no-test] [--build] [--commit] [--allow-rewind]: the only way to
# move the core pin (submodules/telegram-ios) to a newer iOS main commit (default origin/main) or to mac/core-lts.
# Checks the commit is on iOS main/LTS, published, rooted at our import and ahead of the pin; moves and stages the
# pin; runs tg test (NanogramKit + changed packages) and tg parity (plus tg build with --build); puts the old pin
# back when any fails; with --commit commits only the pin as "mac-core: <sha> (<subject>)".
cmd_core_bump() {
  local target="" dry_run=0 fetch=1 test=1 build=0 commit=0 rewind=0 plan_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=1 ;;
      --no-fetch) fetch=0 ;;
      --no-test) test=0 ;;
      --build) build=1 ;;
      --commit) commit=1 ;;
      --allow-rewind) rewind=1 ;;
      -*) die "unknown core-bump option: $1" ;;
      *) [ -z "$target" ] || die "core-bump takes one REF or SHA"; target="$1" ;;
    esac
    shift
  done
  [ -z "$target" ] || plan_args+=("$target")
  [ "$fetch" = 1 ] || plan_args+=(--no-fetch)
  [ "$rewind" = 0 ] || plan_args+=(--allow-rewind)
  local old
  old="$(git rev-parse HEAD:submodules/telegram-ios)"
  if [ "$dry_run" = 1 ]; then py sync core-bump --dry-run ${plan_args[@]+"${plan_args[@]}"}; return; fi
  py sync core-bump ${plan_args[@]+"${plan_args[@]}"} || exit 1
  local failed=()
  if [ "$test" = 1 ]; then (cmd_test) || failed+=(test); fi
  if [ "$build" = 1 ]; then (cmd_build) || failed+=(build); fi
  # Parity checks the staged pin: HEAD still records the old one, and a mirror file changed on both sides
  # matches only the new core.
  (cmd_parity --pin "$(git rev-parse :submodules/telegram-ios)") || failed+=(parity)
  if [ ${#failed[@]} != 0 ]; then
    py sync core-bump --revert "$old"
    die "core-bump stopped (${failed[*]} failed); the pin is back at ${old:0:10}"
  fi
  if [ "$commit" = 1 ]; then
    py sync core-bump --finish
  else
    say "Pin staged. Commit it with: git commit -m 'mac-core: ...' -- submodules/telegram-ios (or rerun with --commit)"
  fi
}

tglint() { python3 "$ROOT/tools/dev/lint/tglint.py" "$@"; }

# tg lint [--base REV | --commits A..B] [--strict]: SwiftLint (pinned, installed on first use) on changed lines.
cmd_lint() {
  tglint install >/dev/null || die "cannot install SwiftLint (python3 tools/dev/lint/tglint.py install)"
  tglint lint "$@"
}

# tg test [--base REV] [package ...]: swift test (or Tests/run-tests.sh when the package has one; packages without a
# test target are skipped with a note) for the named packages, or for NanogramKit plus every package
# with a Tests/ folder changed since REV (default: where unpushed work starts).
# TG_TEST_DROP_SCRATCH=1 deletes a package's SwiftPM scratch folder after its tests pass (each holds a full core build).
cmd_test() {
  local base="" packages=() package failed=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) [ $# -ge 2 ] || die "--base needs a revision"; base="$2"; shift ;;
      -*) die "unknown test option: $1" ;;
      *) packages+=("$1") ;;
    esac
    shift
  done
  if [ ${#packages[@]} = 0 ]; then
    local listed
    listed="$(tglint affected-packages ${base:+--base "$base"})" || die "cannot list the packages to test (tglint affected-packages failed)"
    while IFS= read -r package; do
      [ -z "$package" ] || packages+=("$package")
    done <<< "$listed"
    [ ${#packages[@]} != 0 ] || die "no packages to test: tglint affected-packages listed none (it always lists NanogramKit)"
  fi
  python3 "$ROOT/scripts/prepare-telegram-api.py" || die "cannot generate the TelegramApi sources"
  python3 "$ROOT/scripts/prepare-flat-serialization.py" || die "cannot generate the FlatSerialization sources"
  for package in "${packages[@]}"; do
    [ -f "$ROOT/packages/$package/Package.swift" ] || die "no package packages/$package"
    if [ -x "$ROOT/packages/$package/Tests/run-tests.sh" ]; then
      # Packages that need the Xcode-built native libraries (swift test hangs or fails to link) ship their own runner.
      say "packages/$package/Tests/run-tests.sh"
      "$ROOT/packages/$package/Tests/run-tests.sh" || failed+=("$package")
    elif ! grep -q '\.testTarget(' "$ROOT/packages/$package/Package.swift"; then
      say "no tests: packages/$package has no test target, skipped"
    else
      say "swift test packages/$package"
      local scratch
      scratch="${NANOGRAM_CACHE_DIR:-$HOME/.cache/nanogram-macos}/spm-$(basename "$ROOT")-$package"
      if swift test --package-path "$ROOT/packages/$package" --scratch-path "$scratch"; then
        [ "${TG_TEST_DROP_SCRATCH:-0}" != 1 ] || rm -rf "$scratch"
      else
        failed+=("$package")
      fi
    fi
  done
  [ ${#failed[@]} = 0 ] || die "tests failed: ${failed[*]}"
}

# tg check [--base REV]: everything a push must pass (the pre-push hook runs it): tooling tests, parity gate, lint of the
# unpushed lines, a clean debug build with buildcheck, editions and the warning baseline, package tests.
# Every step runs; exit 1 when any failed.
cmd_check() {
  local base=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) [ $# -ge 2 ] || die "--base needs a revision"; base="$2"; shift ;;
      *) die "unknown check option: $1" ;;
    esac
    shift
  done
  [ -n "$base" ] || base="$(tglint default-base)"
  local tg="$ROOT/tools/dev/tg" start=$SECONDS failed=() step step_start
  local steps=("tools/dev/tests/run.sh" "parity" "lint --base $base" "warnings" "test --base $base")
  for step in "${steps[@]}"; do
    say "check: $step"
    step_start=$SECONDS
    local status=0
    # shellcheck disable=SC2086 # steps are word lists
    case "$step" in
      tools/*) "$ROOT/$step" || status=$? ;;
      *) "$tg" $step || status=$? ;;
    esac
    [ "$status" = 0 ] || failed+=("$step")
    say "check: $step: $([ "$status" = 0 ] && echo ok || echo "FAILED ($status)") in $((SECONDS - step_start))s"
  done
  if [ ${#failed[@]} != 0 ]; then
    die "tg check failed after $((SECONDS - start))s: ${failed[*]}"
  fi
  say "tg check passed in $((SECONDS - start))s"
}

usage() {
  cat <<USAGE
usage: tools/dev/tg <command> [options]

  setup            submodules, Rust toolchain, native libraries, git rerere
  submodules       update every submodule to its pin, leaving out the core's duplicates of webrtc, tgcalls, twidget, widget-sandbox and QuickJS
  upstream-sync    dry run of an upstream release merge: conflicts by area, bumped pins (changes nothing)
  doctor           check prerequisites
  frameworks       native libraries (arm64): current, restored from the shared cache, or built [--no-cache] [--verify-only]
  credentials      generate NanogramSecrets.swift from ~/.config/telegram-ios/api-credentials.json
  build            build the app [--release] [--clean] [--resolve-packages] [--edition mas|direct]
  xcode [edition]  open the workspace in Xcode with our settings (quit Xcode first)
  sparkle-key      create the Sparkle EdDSA key once, print its public key [sign <archive>]
  run              build and launch the app
  test             swift test: NanogramKit + changed packages with Tests/ [--base REV] [package ...]
  lint             SwiftLint on changed Swift lines [--base REV | --commits A..B] [--strict]
  warnings         clean debug build, compare upstream warnings with the baseline [--update] [--log FILE]
  check            tests, lint, clean build + warnings, package tests (pre-push gate) [--base REV]
  perf             performance tests with repository baselines per machine model: run|check|record|model (shared/tools/perfgate.py; not part of check)
  parity           iOS/macOS parity gate: roots, published pins, shared SHAs, core pin lag, shared files [--release]
  core-bump        move the core pin to a newer iOS main commit, test, gate, commit [REF|SHA] [--dry-run] [--commit]
  sync-upstream    fast-forward upstream, merge it, rebuild, update the warning baseline [--no-build] [--after-merge]
  testflight       archive and upload the mas edition [--export-only]
  release-direct   notarized dmg + appcast for the direct edition (local) --notes FILE [--allow-dirty]; FILE is relative to where you run tg
  clean            remove this checkout's build products [--all]
  apps             keep one Nanogram in Spotlight: unregister build copies, keep /Applications/Nanogram.app [--dry-run]
  prune            list caches and build files, remove stale ones [--dry-run] [--max-gb N]
  cache-cleanup    shared cache cleanup (Bazel, Xcode, SwiftPM, builds, worktrees) [--dry-run] [--only A,B] | verify | report | guard
  worktree         add <name> [--branch B] [--from REF] | remove <name> [--force]: parallel checkout with its caches
  native           drift check: native-libs.json and module-settings.json against the build files; local manifest paths
  tests-audit      list tools/tests runners and check, without compiling, that their sources and anchors still exist (report only, not part of check)
USAGE
}

# tg perf run [--package DIR ...] | check | record | model [perfgate options]: the performance tests that need no app
# (docs/profiling.md, "Tests that measure"). `run` runs the *PerformanceTests of the SwiftPM packages (default: TGUIKit and
# the core's Postbox) on this machine with TG_PERF=1 and compares the numbers with shared/tools/perf/baselines.json
# (shared/tools/perfgate.py); a missing baseline is recorded on the owner's devices, never a failure. Not part of
# `tg check` or the pre-push gate.
cmd_perf() {
  local sub="${1:-}"
  case "$sub" in
    check|record|model) shared_tool perfgate.py "$@" ;;
    run)
      shift
      local packages=() gate_args=() log package
      while [ $# -gt 0 ]; do
        case "$1" in
          --package) [ $# -ge 2 ] || die "--package needs a directory"; packages+=("$2"); shift ;;
          *) gate_args+=("$1") ;;
        esac
        shift
      done
      [ ${#packages[@]} -gt 0 ] || packages=(packages/TGUIKit submodules/telegram-ios/submodules/Postbox)
      log="$(mktemp -t tg-perf.XXXXXX)"
      for package in "${packages[@]}"; do
        say "Performance tests in $package"
        TG_PERF=1 swift test --package-path "$ROOT/$package" --filter PerformanceTests 2>&1 | tee -a "$log"
      done
      shared_tool perfgate.py check --suite swift-host --log "$log" ${gate_args[@]+"${gate_args[@]}"}
      ;;
    *) die "usage: tools/dev/tg perf run [--package DIR ...] [perfgate options] | check|record|model [perfgate options]" ;;
  esac
}

main() {
  local cmd="${1:-help}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    build|test|check|warnings|frameworks|testflight|release-direct|core-bump|sync-upstream) trap after_build_command EXIT ;;
  esac
  case "$cmd" in
    build|test|check|warnings|testflight|release-direct) cache_guard ;;
  esac
  case "$cmd" in
    doctor) cmd_doctor "$@" ;;
    setup) cmd_setup "$@" ;;
    submodules) cmd_submodules ;;
    upstream-sync) cmd_upstream_sync "$@" ;;
    frameworks) cmd_frameworks "$@" ;;
    clean) cmd_clean "$@" ;;
    prune) cmd_prune "$@" ;;
    cache-cleanup) cmd_cache_cleanup "$@" ;;
    apps) cmd_apps "$@" ;;
    worktree) cmd_worktree "$@" ;;
    native) cmd_native "$@" ;;
    tests-audit) py testsaudit "$@" ;;
    credentials) cmd_credentials ;;
    build) cmd_build "$@" ;;
    xcode) cmd_xcode "$@" ;;
    sparkle-key) cmd_sparkle_key "$@" ;;
    warnings) cmd_warnings "$@" ;;
    sync-upstream) cmd_sync_upstream "$@" ;;
    lint) cmd_lint "$@" ;;
    test) cmd_test "$@" ;;
    check) cmd_check "$@" ;;
    parity) cmd_parity "$@" ;;
    perf) cmd_perf "$@" ;;
    core-bump) cmd_core_bump "$@" ;;
    testflight) cmd_testflight "$@" ;;
    release-direct) cmd_release_direct "$@" ;;
    run) not_yet "$cmd" ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command: $cmd" ;;
  esac
}

main "$@"
