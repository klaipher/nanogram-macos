#!/usr/bin/env bash
# tg — local development helper for Nanogram for macOS.
# Argument parsing only; the logic lives in tools/dev/nanogram/*.py.
# See docs/local-development.md.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

export PATH="/opt/homebrew/opt/rustup/bin:$PATH"
if [ -z "${DEVELOPER_DIR:-}" ]; then
  DEVELOPER_DIR="$(xcode-select -p 2>/dev/null || true)"
  export DEVELOPER_DIR
fi
export PYTHONPATH="$ROOT/tools/dev${PYTHONPATH:+:$PYTHONPATH}"

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

py() { python3 -m "nanogram.$1" "${@:2}"; }

not_yet() { die "tg $1 is not implemented yet"; }

config_value() { python3 -c "from nanogram import config; print(config.$1)"; }

cmd_doctor() { py doctor; }

cmd_frameworks() { py frameworks "$@"; }

# Writes the gitignored NanogramSecrets.swift (api_id/api_hash); prints only the path, never the values.
cmd_credentials() { py credentials || die "cannot generate API credentials"; }

# Sparkle EdDSA key for the direct edition: creates ~/.config/nanogram-macos/sparkle_ed25519 (0600) once and
# prints the public key (SUPublicEDKey); `tg sparkle-key sign <archive>` prints the appcast signature.
cmd_sparkle_key() {
  if [ "${1:-}" = sign ]; then py sparkle sign "${@:2}"; else py sparkle public-key; fi
}

# Idempotent working-tree fixes inside submodules (tools/dev/nanogram/localfixes.py).
cmd_localfixes() { py localfixes || die "cannot apply local submodule fixes"; }

cmd_setup() {
  say "Fetching submodules"
  git submodule sync --recursive >/dev/null
  git submodule update --init --recursive --jobs 8
  cmd_localfixes
  local toolchain
  toolchain="$(sed -n 's/^channel *= *"\(.*\)"/\1/p' submodules/telegram-ios/third-party/mtproto-engine/rust-toolchain.toml)"
  [ -n "$toolchain" ] || die "cannot read the Rust toolchain pinned in submodules/telegram-ios/third-party/mtproto-engine/rust-toolchain.toml"
  command -v rustup >/dev/null || die "rustup missing: brew install rustup"
  say "Installing Rust $toolchain (pinned upstream)"
  rustup toolchain install "$toolchain" --profile minimal
  rustup target add --toolchain "$toolchain" aarch64-apple-darwin
  cmd_frameworks
}

edition_xcconfig() {
  local file="$ROOT/nanogram/editions/$1.xcconfig"
  [ -f "$file" ] || die "unknown edition '$1' (no $file)"
  echo "$file"
}

# tg build [--release] [--clean] [--edition mas|direct] [-- extra xcodebuild args]
# --clean deletes DerivedData/Build first, so every file compiles and every warning is in the log.
cmd_build() {
  local release=0 clean=0 edition=direct extra=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --release) release=1 ;;
      --clean) clean=1 ;;
      --edition) [ $# -ge 2 ] || die "--edition needs mas or direct"; edition="$2"; shift ;;
      --) shift; extra=("$@"); break ;;
      *) die "unknown build option: $1" ;;
    esac
    shift
  done
  local xcconfig scheme configuration conditions derived log
  xcconfig="$(edition_xcconfig "$edition")"
  if [ "$release" = 1 ]; then scheme=Release configuration=Release; else scheme=Telegram configuration=Debug; fi
  conditions='$(inherited) NANOGRAM STABLE'
  [ "$edition" = mas ] && conditions="$conditions NANOGRAM_MAS"
  derived="$(config_value DERIVED_DATA)"
  mkdir -p "$ROOT/build-output"
  log="$ROOT/build-output/last-build.log"
  cmd_localfixes
  cmd_credentials
  if [ "$clean" = 1 ]; then
    say "Cleaning ${derived}/Build"
    rm -rf "${derived:?}/Build"
  fi
  py editions --edition "$edition" --before-build "$derived"

  say "Building $configuration ($edition edition), log: build-output/last-build.log"
  local start=$SECONDS status=0
  xcodebuild build \
    -workspace Telegram-Mac.xcworkspace -scheme "$scheme" -configuration "$configuration" \
    -destination 'platform=macOS,arch=arm64' -derivedDataPath "$derived" \
    -xcconfig "$xcconfig" \
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS=$conditions" \
    COMPILER_INDEX_STORE_ENABLE=NO \
    -showBuildTimingSummary ${extra[@]+"${extra[@]}"} > "$log" 2>&1 || status=$?
  local elapsed=$((SECONDS - start))
  if [ "$status" != 0 ]; then
    grep -E '(error|fatal error):' "$log" | sort -u | head -30 >&2 || true
    die "build failed after ${elapsed}s (exit $status); full log: $log"
  fi
  say "Built in ${elapsed}s; checking architectures and deployment target"
  local check_args=(--log "$log" --products "$derived/Build/Products/$configuration")
  [ "$release" = 1 ] && check_args+=(--release)
  py buildcheck "${check_args[@]}" || die "buildcheck failed: the settings layer did not reach every target"
  py editions --edition "$edition" --configuration "$configuration" --products "$derived/Build/Products/$configuration" \
    || die "the $edition edition is wrong (signing, sandbox or Sparkle); see above"
}

# tg warnings [--update] [--log FILE]: counts upstream warnings of a clean debug build (built here unless
# --log names one) and fails when a package has more than nanogram/warnings-baseline.json allows.
cmd_warnings() {
  local log="" args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --update) args+=(--update) ;;
      --log) [ $# -ge 2 ] || die "--log needs a file"; log="$2"; shift ;;
      *) die "unknown warnings option: $1" ;;
    esac
    shift
  done
  if [ -z "$log" ]; then
    cmd_build --clean
    log="$ROOT/build-output/warnings-build.log"
    cp "$ROOT/build-output/last-build.log" "$log"
  fi
  py warnings --log "$log" ${args[@]+"${args[@]}"}
}

cmd_xcode() {
  local edition="${1:-direct}" xcconfig
  xcconfig="$(edition_xcconfig "$edition")"
  cmd_credentials
  if pgrep -x Xcode >/dev/null; then
    warn "Xcode is already running and will not see XCODE_XCCONFIG_FILE; quit it first, then run tg xcode again"
  fi
  say "Opening the workspace with XCODE_XCCONFIG_FILE=${xcconfig#"$ROOT"/}"
  open --env "XCODE_XCCONFIG_FILE=$xcconfig" -a Xcode "$ROOT/Telegram-Mac.xcworkspace"
}

usage() {
  cat <<USAGE
usage: tools/dev/tg <command> [options]

  setup            submodules, Rust toolchain, native libraries
  doctor           check prerequisites
  frameworks       build the native libraries (arm64) [--verify-only]
  credentials      generate NanogramSecrets.swift from ~/.config/telegram-ios/api-credentials.json
  build            build the app [--release] [--clean] [--edition mas|direct]
  xcode [edition]  open the workspace in Xcode with our settings (quit Xcode first)
  sparkle-key      create the Sparkle EdDSA key once, print its public key [sign <archive>]
  run              build and launch the app
  test             swift test for our packages
  lint             tglint on changed Swift files
  warnings         clean debug build, compare upstream warnings with the baseline [--update] [--log FILE]
  check            everything a push must pass
  sync-upstream    merge telegram/master
  testflight       archive and upload the mas edition
  release-direct   notarized dmg + appcast for the direct edition (local)
USAGE
}

main() {
  local cmd="${1:-help}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    doctor) cmd_doctor "$@" ;;
    setup) cmd_setup "$@" ;;
    frameworks) cmd_frameworks "$@" ;;
    credentials) cmd_credentials ;;
    build) cmd_build "$@" ;;
    xcode) cmd_xcode "$@" ;;
    sparkle-key) cmd_sparkle_key "$@" ;;
    warnings) cmd_warnings "$@" ;;
    run|test|lint|check|sync-upstream|testflight|release-direct) not_yet "$cmd" ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command: $cmd" ;;
  esac
}

main "$@"
