// Nanogram build settings for every target: the app, the workspace subprojects and the SwiftPM packages.
// tools/dev/tg passes it with -xcconfig (Xcode UI: XCODE_XCCONFIG_FILE, see `tg xcode`), which ranks above
// project and target settings, so upstream's project files stay untouched.

MACOSX_DEPLOYMENT_TARGET = 15.0
ARCHS = arm64
VALID_ARCHS = arm64
ONLY_ACTIVE_ARCH = YES

SWIFT_OPTIMIZATION_LEVEL[config=Debug] = -Onone
LLVM_LTO[config=Debug] = NO

// Day-to-day Debug speed (docs/local-development.md, "Day-to-day build speed"). Debug only: Release, archives and
// the mas export keep upstream's values. The module verifier re-checks Sparkle and CodeSyntax on every build
// (2–8 s); App Intents metadata extraction ran 170 times in a clean build of an app without App Intents.
// The other three pin today's Debug values against upstream drift.
DEBUG_INFORMATION_FORMAT[config=Debug] = dwarf
SWIFT_COMPILATION_MODE[config=Debug] = singlefile
GCC_OPTIMIZATION_LEVEL[config=Debug] = 0
ENABLE_MODULE_VERIFIER[config=Debug] = NO
LM_SKIP_METADATA_EXTRACTION[config=Debug] = YES
COMPILATION_CACHE_ENABLE_CACHING[config=Debug] = YES
COMPILATION_CACHE_CAS_PATH[config=Debug] = $(HOME)/.cache/nanogram-macos/CompilationCache
COMPILATION_CACHE_LIMIT_SIZE[config=Debug] = 10737418240

GCC_OPTIMIZATION_LEVEL[config=Release] = 3
LLVM_LTO[config=Release] = YES_THIN
DEAD_CODE_STRIPPING[config=Release] = YES
// Screens that run only when opened (wallet, stars, settings, passport, export, ...) are built for size.
NANOGRAM_SWIFT_OPT_WalletContext = -Osize
NANOGRAM_SWIFT_OPT_WalletUI = -Osize
NANOGRAM_SWIFT_OPT_StarsUI = -Osize
NANOGRAM_SWIFT_OPT_SettingsUI = -Osize
NANOGRAM_SWIFT_OPT_RichTextEditorUI = -Osize
NANOGRAM_SWIFT_OPT_InstantPageUI = -Osize
NANOGRAM_SWIFT_OPT_WebAppUI = -Osize
NANOGRAM_SWIFT_OPT_ImageCanvasUI = -Osize
NANOGRAM_SWIFT_OPT_PassportUI = -Osize
NANOGRAM_SWIFT_OPT_QrStudioUI = -Osize
NANOGRAM_SWIFT_OPT_ChatExportUI = -Osize
NANOGRAM_SWIFT_OPT_PremiumUI = -Osize
SWIFT_OPTIMIZATION_LEVEL[config=Release] = $(NANOGRAM_SWIFT_OPT_$(TARGET_NAME):default=-O)
SWIFT_COMPILATION_MODE[config=Release] = wholemodule

// Identity. Xcode has no per-target xcconfig conditions, so per-target values are looked up by
// TARGET_NAME; every other target (Sparkle, workspace subprojects, packages) keeps its own value.
DEVELOPMENT_TEAM = YGTMYL879P
NANOGRAM_BUNDLE_ID_Telegram = org.klaipher.Nanogram
NANOGRAM_BUNDLE_ID_TelegramShare = org.klaipher.Nanogram.MacShare
PRODUCT_BUNDLE_IDENTIFIER = $(NANOGRAM_BUNDLE_ID_$(TARGET_NAME):default=$(inherited))

// Local builds sign with the team's Apple Development identity, no provisioning profile
// (nothing we use is a restricted entitlement on macOS). Distribution signing happens at export.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Development
PROVISIONING_PROFILE_SPECIFIER =

// Telegram's unused Firebase config (FirebaseApp.configure() is commented out upstream) and the OCR model
// ocr_nn.bin (no macOS reader since runtime H12); editions add their own exclusions through NANOGRAM_EDITION_EXCLUDED_FILES.
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) GoogleService-Info.plist ocr_nn.bin $(NANOGRAM_EDITION_EXCLUDED_FILES)

// Branding: the app is Nanogram.app/Contents/MacOS/Nanogram. Its Swift module stays "Telegram": the
// MainMenu.xib files and ObjC bridging refer to it by that name.
NANOGRAM_PRODUCT_NAME_Telegram = Nanogram
PRODUCT_NAME = $(NANOGRAM_PRODUCT_NAME_$(TARGET_NAME):default=$(inherited))
NANOGRAM_MODULE_NAME_Telegram = Telegram
PRODUCT_MODULE_NAME = $(NANOGRAM_MODULE_NAME_$(TARGET_NAME):default=$(inherited))

// No Telegram update feed (upstream's Debug/Release xcconfigs point Sparkle at mac-updates.telegram.org);
// the direct edition sets its own.
SFEED_URL =
DSA_PEM_FILE =

// Strictness A for upstream code: the same data-race checks our packages have, reported as warnings and
// counted per package in nanogram/warnings-baseline.json (tg warnings). Our packages build in Swift 6 mode
// with warnings as errors on top of this. TelegramCore's manifest adds -warnings-as-errors, which would turn its
// new concurrency warnings into errors (Swift has no umbrella group for -Wwarning); there the baseline is the gate.
NANOGRAM_SWIFT_FLAGS_TelegramCore = -no-warnings-as-errors
OTHER_SWIFT_FLAGS = $(inherited) -strict-concurrency=complete $(NANOGRAM_SWIFT_FLAGS_$(TARGET_NAME))

// Launch order file (M31) for the app's Release link only. tools/dev/nanogram/release.py passes
// NANOGRAM_ORDER_FILE on the command line when Telegram-Mac/OrderFiles/Telegram.order exists, so a checkout
// without one still links. M17 (no runtime exclusivity checks in Release) is a command-line setting there too.
NANOGRAM_ORDER_FILE_Telegram = $(NANOGRAM_ORDER_FILE)
ORDER_FILE[config=Release] = $(NANOGRAM_ORDER_FILE_$(TARGET_NAME):default=$(inherited))

// Memory-safety hardening for the C, C++ and Objective-C the build compiles (the iOS app's .bazelrc sets the same three):
// automatic variables start zeroed, libc++ traps on out-of-bounds container access in constant time, and every
// function with a local array or address-taken local gets a stack canary. Libraries built by their own scripts
// (dav1d, libvpx, opus, libwebp, libjpeg-turbo) take their flags from those scripts; FFmpeg's adds the stack protector.
// Debug C++ already compiles with Xcode's own _LIBCPP_HARDENING_MODE_DEBUG; a second definition would be a redefinition warning.
OTHER_CFLAGS = $(inherited) -ftrivial-auto-var-init=zero -fstack-protector-strong
OTHER_CPLUSPLUSFLAGS = $(inherited) -ftrivial-auto-var-init=zero -fstack-protector-strong
GCC_PREPROCESSOR_DEFINITIONS[config=Release] = $(inherited) _LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST

// Apple Enhanced Security in soft mode (tools/dev/nanogram/enhanced_security.py): off unless the build is given
// NANOGRAM_ENHANCED_SECURITY_REQUEST=YES, because the App ID needs the Enhanced Security capability and a new
// profile first. The editions append the suffix to the entitlement file name.
NANOGRAM_ENHANCED_SECURITY = $(NANOGRAM_ENHANCED_SECURITY_REQUEST:default=NO)
NANOGRAM_ENTITLEMENTS_SUFFIX_YES = -EnhancedSecurity
NANOGRAM_ENTITLEMENTS_SUFFIX_NO =
NANOGRAM_ENTITLEMENTS_SUFFIX = $(NANOGRAM_ENTITLEMENTS_SUFFIX_$(NANOGRAM_ENHANCED_SECURITY))
